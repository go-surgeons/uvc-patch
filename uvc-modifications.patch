+	while (uvc_queue_streaming(&stream->queue)) {
+		attempt++;
+		atomic_inc(&stream->recovery.stats.recycle_attempts);
+		dev_info(&stream->intf->dev, "stream recovery attempt %u\n",
+			 attempt);
+
+		/*
+		 * Suspend-equivalent: freeze, kill URBs, then tell the device
+		 * the stream stopped the same way uvc_video_stop_streaming()
+		 * does: alt setting 0 for isochronous devices, CLEAR_FEATURE
+		 * (HALT) on the streaming endpoint for bulk devices (the
+		 * affected cameras). SET_INTERFACE(0) does not clear a halted bulk
+		 * endpoint, so a wedged device would survive the recycle and
+		 * recovery would loop forever.
+		 */
+		stream->frozen = 1;
+		uvc_video_stop_transfer(stream, 0);
+		if (stream->intf->num_altsetting > 1) {
+			usb_set_interface(stream->dev->udev, stream->intfnum, 0);
+		} else {
+			unsigned int epnum = stream->header.bEndpointAddress
+					   & USB_ENDPOINT_NUMBER_MASK;
+			unsigned int dir = stream->header.bEndpointAddress
+					 & USB_ENDPOINT_DIR_MASK;
