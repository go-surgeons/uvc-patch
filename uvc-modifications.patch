+			pipe = usb_sndbulkpipe(stream->dev->udev, epnum) | dir;
+			usb_clear_halt(stream->dev->udev, pipe);
+		}
+
+		/*
+		 * Abandon the partially assembled frame and resynchronize to
+		 * the next frame boundary. The recycle joins the camera's
+		 * payload stream at an arbitrary byte offset; splicing that
+		 * into a half-filled buffer (or starting a fresh one mid-
+		 * frame) breaks the YUY2 byte phase and flashes a green/
+		 * magenta frame. Dropping payloads until the FID toggles
+		 * costs at most one camera frame and keeps userspace showing
+		 * the last good frame across the recycle instead.
+		 */
+		uvc_queue_rewind_current_buffer(&stream->queue);
+		stream->recovery.resync_fid = -1;
+		stream->recovery.resync_bounds = 0;
+		set_bit(UVC_RECOVERY_RESYNC, &stream->recovery.flags);
+
+		{
+			unsigned int settle = READ_ONCE(uvc_recovery_settle_param);
+
+			if (settle)
+				msleep(settle);
+		}
+
+		/* Resume-equivalent: unfreeze, re-probe, re-commit, rebuild URBs. */
+		stream->frozen = 0;
+		uvc_video_clock_reset(&stream->clock);
+
+		/*
+		 * PROBE renegotiation, mirroring what userspace lightweight
+		 * recovery triggers via VIDIOC_S_PARM: a full SET_CUR/GET_CUR
+		 * PROBE round resets the device's UVC negotiation state machine
+		 * in a way a lone COMMIT does not. Concurrent S_FMT/S_PARM are
+		 * locked out while streaming, so stream->ctrl is ours. Probe
+		 * failure is not fatal: fall back to committing the cached
+		 * control, as userspace lightweight recovery does.
+		 */
+		probe = stream->ctrl;
+		if (uvc_probe_video(stream, &probe) >= 0)
+			stream->ctrl = probe;
+
+		/* uvc_commit_video() returns a positive byte count on success. */
+		ret = uvc_commit_video(stream, &stream->ctrl);
+		if (ret < 0) {
+			dev_warn(&stream->intf->dev,
+				 "recovery: commit failed (%d)\n", ret);
+		} else {
+			ret = uvc_video_start_transfer(stream, GFP_KERNEL);
+			if (ret < 0)
+				dev_warn(&stream->intf->dev,
+					 "recovery: start_transfer failed (%d)\n",
+					 ret);
+		}
+		if (ret >= 0) {
+			/*
+			 * commit/start_transfer succeeding only proves the
+			 * control plane is alive; the wedge is cleared only
+			 * once payload actually arrives. uvc_recovery_frame()
+			 * then confirms (logs "stream recovered") and resets
+			 * the round budget; until that happens the no-frame
+			 * timer keeps the episode open.
+			 */
+			stream->recovery.last_complete = jiffies;
+			stream->recovery.grace_until = jiffies +
+				msecs_to_jiffies(UVC_RECOVERY_GRACE_MS);
+			set_bit(UVC_RECOVERY_PENDING, &stream->recovery.flags);
+			uvc_dbg(stream->dev, VIDEO,
+				"stream recycled (attempt %u), awaiting payload\n",
+				attempt);
+			goto done;
+		}
+
+		if (attempt >= UVC_RECOVERY_MAX_ATTEMPTS) {
+			dev_err(&stream->intf->dev,
+				"stream recovery failed after %u attempts, giving up\n",
+				attempt);
+			goto giveup;
+		}
+	}
+	goto done;
+
+giveup:
+	/* Wake userspace with an error; method-B watchdogs take over. */
+	atomic_inc(&stream->recovery.stats.giveups);
+	clear_bit(UVC_RECOVERY_PENDING, &stream->recovery.flags);
+	set_bit(UVC_RECOVERY_DEAD, &stream->recovery.flags);
+	uvc_queue_cancel(&stream->queue, 0);
+done:
+	clear_bit(UVC_RECOVERY_ACTIVE, &stream->recovery.flags);
+	mutex_unlock(&stream->queue.mutex);
+}
