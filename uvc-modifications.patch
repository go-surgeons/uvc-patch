+void uvc_video_recovery_init(struct uvc_streaming *stream)
+{
+	INIT_WORK(&stream->recovery.work, uvc_recovery_work);
+	timer_setup(&stream->recovery.timer, uvc_recovery_timer_fn, 0);
+}
