+/* ------------------------------------------------------------------------
+ * STREAM_RECOVERY quirk: in-driver stream stall recovery
+ *
+ * Affected cameras wedge: URB completions stop, silently. Field
+ * observation (9h, 56 natural wedges, usbmon-corroborated) found no errored
+ * completion before or during any episode — the wedge is a silent stop, not
+ * an error burst — so detection is a no-frame watchdog timer only. Recover
+ * transparently to userspace:
+ *   recycle the stream (suspend/resume-equivalent) from a work item;
+ *   if that keeps failing, give up and cancel the queue so userspace
+ *   watchdogs take over.
+ */
+
+#define UVC_RECOVERY_MAX_ATTEMPTS	5	/* recycle retries per round */
+#define UVC_RECOVERY_MAX_ROUNDS		3	/* rounds without a good frame */
+/*
+ * Auto timeout (recovery_timeout_ms=0): 4 frame intervals, clamped to
+ * 30..1000ms. Healthy payload gaps are quantized in frame intervals (frame
+ * skips); the longest steady-state gap seen on the bus in the field is
+ * ~2.4 intervals (40.2ms at 60fps, 55min of usbmon around 37 natural
+ * wedges), while a wedge never self-heals, so 4 intervals separates the
+ * two cleanly at any frame rate and low-fps modes scale automatically.
+ */
+#define UVC_RECOVERY_TIMEOUT_FI		4	/* auto timeout, frame intervals */
+#define UVC_RECOVERY_TIMEOUT_MIN_MS	30
+#define UVC_RECOVERY_TIMEOUT_MAX_MS	1000
+/*
+ * Mute the no-frame watchdog for this long after STREAMON and after each
+ * recovery recycle. The camera needs ~250-300ms from (re)commit to the first
+ * payload, so a sub-300ms recovery_timeout_ms would otherwise re-trigger
+ * before the stream can come up and burn the whole round budget on a
+ * healthy device (observed: 11 rounds -> DEAD within 4s of STREAMON at
+ * timeout=100ms). Mirrors the grace-period reset step of the userspace
+ * lightweight recovery this recovery is modeled on.
+ */
+#define UVC_RECOVERY_GRACE_MS		1000
+
+/* Kernels < 6.16 spell timer_container_of() as from_timer(). */
+#ifndef timer_container_of
+#define timer_container_of(var, timer, field) from_timer(var, timer, field)
+#endif
+
+static void uvc_video_stop_transfer(struct uvc_streaming *stream,
+				    int free_buffers);
+static int uvc_video_start_transfer(struct uvc_streaming *stream,
+				    gfp_t gfp_flags);
+
+static bool uvc_recovery_enabled(struct uvc_streaming *stream)
+{
+	if (uvc_stream_recovery_param == 0)
+		return false;
+	if (uvc_stream_recovery_param > 0)
+		return true;
+	return !!(stream->dev->quirks & UVC_QUIRK_STREAM_RECOVERY);
+}
+
+/* Effective no-frame watchdog timeout: fixed param value, or frame-interval
+ * scaled auto default (see UVC_RECOVERY_TIMEOUT_FI). dwFrameInterval is in
+ * 100ns units and already CPU byte order. */
+static unsigned int uvc_recovery_timeout_ms(struct uvc_streaming *stream)
+{
+	unsigned int timeout = READ_ONCE(uvc_recovery_timeout_param);
+
+	if (timeout)
+		return timeout;
+	timeout = UVC_RECOVERY_TIMEOUT_FI * (stream->ctrl.dwFrameInterval / 10000);
+	return clamp(timeout, (unsigned int)UVC_RECOVERY_TIMEOUT_MIN_MS,
+		     (unsigned int)UVC_RECOVERY_TIMEOUT_MAX_MS);
+}
+
+static void uvc_recovery_trigger(struct uvc_streaming *stream)
+{
+	if (test_bit(UVC_RECOVERY_DEAD, &stream->recovery.flags))
+		return;
+	if (test_and_set_bit(UVC_RECOVERY_ACTIVE, &stream->recovery.flags))
+		return;
+	/* rounds is reset only by decoded payload; stamp the episode start. */
+	if (stream->recovery.rounds++ == 0)
+		stream->recovery.stall_jiffies = jiffies;
+	schedule_work(&stream->recovery.work);
+}
+
+static void uvc_recovery_timer_fn(struct timer_list *t)
+{
+	struct uvc_streaming *stream = timer_container_of(stream, t,
+							   recovery.timer);
+	unsigned int timeout = uvc_recovery_timeout_ms(stream);
+
+	/*
+	 * Stop the self-rearming timer once streaming has stopped.
+	 * uvc_video_stop_streaming() clears ->enabled before timer_delete_sync();
+	 * bailing here keeps the timer from resurrecting itself past teardown
+	 * (risking a use-after-free) and avoids an idle re-arm storm.
+	 */
+	if (!stream->recovery.enabled)
+		return;
+
+	if (!test_bit(UVC_RECOVERY_ACTIVE, &stream->recovery.flags) &&
+	    !test_bit(UVC_RECOVERY_DEAD, &stream->recovery.flags) &&
+	    time_after(jiffies, stream->recovery.grace_until) &&
+	    time_after(jiffies, stream->recovery.last_complete +
+			       msecs_to_jiffies(timeout))) {
+		dev_warn(&stream->intf->dev,
+			 "stream stall detected (no completion for %ums), scheduling recovery\n",
+			 timeout);
+		atomic_inc(&stream->recovery.stats.stalls_detected);
+		uvc_recovery_trigger(stream);
+	}
+
+	/* Poll at a quarter of the timeout so re-arm granularity stays a
+	 * small fraction of the detection latency (was a flat 100ms floor,
+	 * which dominated detection at timeout<=100ms: 119-204ms measured). */
+	mod_timer(&stream->recovery.timer,
+		  jiffies + msecs_to_jiffies(max(timeout / 4, 10u)));
+}
