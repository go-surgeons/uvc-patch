 /*
+ * Stream recovery: only decoded payload proves the device is really
+ * streaming; URB completions alone (bulk ZLPs, header-only payloads) don't.
+ * Called from the decode path (completion handler context) whenever payload
+ * bytes are copied to a video buffer: pets the no-frame watchdog, resets the
+ * recovery round budget and, when a recovery recycle awaits confirmation,
+ * declares it successful.
+ */
+static void uvc_recovery_frame(struct uvc_streaming *stream)
+{
+	if (!stream->recovery.enabled)
+		return;
+
+	stream->recovery.last_complete = jiffies;
+	stream->recovery.rounds = 0;
+	if (unlikely(test_and_clear_bit(UVC_RECOVERY_PENDING,
+					&stream->recovery.flags))) {
+		atomic_inc(&stream->recovery.stats.recycle_recoveries);
+		dev_info(&stream->intf->dev,
+			 "stream recovered (downtime %ums)\n",
+			 jiffies_to_msecs(jiffies -
+					  stream->recovery.stall_jiffies));
+	}
+}
+
+/*
+ * Stream recovery: payload gate while resynchronizing after a recovery
+ * recycle. The recycle joins the camera's payload stream at an arbitrary
+ * point, and the first complete frame the camera emits after the recycle has
+ * been observed to arrive with its chroma phase shifted (U/V swapped frame,
+ * one per recycle). Both problems are cured by dropping payloads until
+ * UVC_RECOVERY_RESYNC_BOUNDS FID changes have been seen: the partial join
+ * frame and the first complete (possibly phase-shifted) frame are discarded
+ * and delivery resumes on a later, clean frame. Userspace keeps displaying
+ * the last good frame across the whole episode.
+ *
+ * Returns true once the boundary budget is exhausted; the caller then
+ * processes the current payload (the first of a clean frame) normally.
+ */
+#define UVC_RECOVERY_RESYNC_BOUNDS	3
+
+static bool uvc_recovery_resync_done(struct uvc_streaming *stream, u8 fid)
+{
+	if (fid == stream->recovery.resync_fid)
+		return false;
+	stream->recovery.resync_fid = fid;
+	if (++stream->recovery.resync_bounds < UVC_RECOVERY_RESYNC_BOUNDS)
+		return false;
+
+	clear_bit(UVC_RECOVERY_RESYNC, &stream->recovery.flags);
+	/* Let the sync logic below accept this frame-start payload. */
+	stream->last_fid = fid ^ UVC_STREAM_FID;
+	return true;
+}
+
