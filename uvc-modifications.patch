+static void uvc_recovery_work(struct work_struct *work)
+{
+	struct uvc_streaming *stream =
+		container_of(work, struct uvc_streaming, recovery.work);
+	struct uvc_streaming_control probe;
+	unsigned int attempt = 0;
+	int ret;
+
+	/*
+	 * queue.mutex serializes against STREAMOFF (which holds it while
+	 * calling uvc_video_stop_streaming) on every supported kernel;
+	 * stream->mutex no longer exists on 6.16+.
+	 */
+	mutex_lock(&stream->queue.mutex);
+
+	/* Injection served its purpose once a stall was detected. */
+	clear_bit(UVC_RECOVERY_INJECT, &stream->recovery.flags);
+
+	/*
+	 * The ACTIVE bit is this work's scheduling token. STREAMON
+	 * (uvc_video_start_streaming) resets recovery.flags, so a cleared
+	 * ACTIVE here means a STREAMOFF/STREAMON cycle raced ahead of us: this
+	 * work is stale and must not recycle the new session's healthy stream.
+	 * STREAMON and this work both run under queue.mutex, so this is race-free.
+	 */
+	if (!test_bit(UVC_RECOVERY_ACTIVE, &stream->recovery.flags) ||
+	    !uvc_queue_streaming(&stream->queue) || stream->frozen)
+		goto done;
