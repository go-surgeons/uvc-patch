+	if (stream->recovery.rounds > UVC_RECOVERY_MAX_ROUNDS) {
+		dev_err(&stream->intf->dev,
+			"stream recovery ineffective after %u rounds, giving up\n",
+			stream->recovery.rounds);
+		goto giveup;
+	}
